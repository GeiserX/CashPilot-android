<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        android:protectionLevel="signature|privileged|development|appop|retailDemo" />
    <uses-permission android:name="android.permission.READ_NETWORK_USAGE_HISTORY" />

    <!-- Package visibility: required on Android 11+ to query third-party apps -->
    <queries>
        <package android:name="com.brd.earnapp.play" />
        <package android:name="com.iproyal.android" />
        <package android:name="network.mysterium.provider" />
        <package android:name="com.traffmonetizer.client" />
        <package android:name="com.bytelixir.blapp" />
        <package android:name="io.bytebenefit.app" />
        <package android:name="io.getgrass.www" />
        <package android:name="com.titan_network_vip.titan_app" />
        <package android:name="io.nodle.cash" />
        <package android:name="com.wipter.app" />
    </queries>

    <application
        android:name=".CashPilotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CashPilotAndroid">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CashPilotAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification Listener — detects foreground notifications from monitored apps -->
        <service
            android:name=".service.AppNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Heartbeats run on WorkManager (service/HeartbeatWorker.kt), which
             declares its own components and reschedules itself after a reboot.
             CashPilotApp supplies its configuration, so WorkManager starts on
             first use instead of from androidx.startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
