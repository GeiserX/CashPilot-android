    <string name="permissions_title">Let CashPilot see your apps</string>
    <string name="permissions_lead">Android hides other apps\' state. Two switches in system settings fix that; you come straight back here.</string>
    <string name="permissions_without">Without both, CashPilot can\'t tell running from stopped. You can allow them later from Settings.</string>
    <string name="permissions_continue">Continue</string>
