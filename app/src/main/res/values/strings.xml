    <!-- %1$d is the number of supported apps -->
    <plurals name="permissions_notif_why">
        <item quantity="one">These apps keep a notification up while they run. CashPilot checks whether it is there, for the %1$d supported apps only.</item>
        <item quantity="other">These apps keep a notification up while they run. CashPilot checks whether it is there, for the %1$d supported apps only.</item>
    </plurals>
    <string name="permissions_notif_not_read">Never reads notification text. You\'ll see exactly what it reads before Android asks.</string>
    <string name="permissions_usage_why">Shows when each supported app last ran and how much data it moved in the last 24 hours, which shows it is working.</string>
    <string name="permissions_usage_not_read">Never looks at other apps or websites. You\'ll see exactly what it reads first.</string>
    <string name="permissions_battery_why">CashPilot reports every 15 minutes. With battery optimisation on, Android can hold those reports back while the screen is off.</string>
    <!-- "All apps" and "Don't optimize" are Android's own settings labels: use the words Android shows in your language. -->
    <string name="permissions_battery_not_read">Optional. Opens Android\'s battery list: choose All apps, then CashPilot, then Don\'t optimize.</string>

