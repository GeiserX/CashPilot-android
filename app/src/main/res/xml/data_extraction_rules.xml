<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later ignore allowBackup="false" for device-to-device
     transfer, so without these rules the settings DataStore, which holds the
     fleet key and this phone's worker key, is copied to a new phone. Keep it on
     this device in both cases: a new phone sets up again and gets its own
     worker key. DataBackupRulesTest checks the DataStore file is excluded
     here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
