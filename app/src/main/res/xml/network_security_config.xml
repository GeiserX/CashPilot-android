<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is off for every host by default, so nothing in the app can
         reach the internet over plain http. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- A CashPilot server at home often has no certificate, so http is allowed
         to names that cannot be public. This file can only list exact hosts and
         domain suffixes, not IP ranges, so a LAN IP over http is not here and
         needs a name or https. ServerUrlPolicy mirrors this list so the app
         explains a refusal before a request is made; NetworkSecurityConfigTest
         fails if the two disagree. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="true">internal</domain>
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
