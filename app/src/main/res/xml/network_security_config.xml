<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext stays on at the base. The common home setup is a CashPilot
         server at http://192.168.x.x with no certificate, and this file can
         only allow plain http per host name or domain suffix, never per
         address range, so turning the base off would refuse every LAN and
         Tailscale address. The gate is ServerUrlPolicy: it refuses to send the
         fleet key over http to any host that can be on the public internet,
         before a request is made. NetworkSecurityConfigTest reads this file
         through Android's own parser and fails if the base is ever off. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- The names the policy allows, written here so the two files say the
         same thing. With the base on they add nothing to what Android allows. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="true">internal</domain>
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
